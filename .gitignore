# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up in here,
# since the whole folder goes to the Workshop as is.
.build/
Source/obj/
Source/bin/


# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Workshop screenshots collected from a Pickle @review run by Art/Update-WorkshopScreenshots.ps1.
# They are regenerated on every run and differ each time - time of day, colonists standing
# elsewhere - so tracking them by default would fill the history with near-identical 2 MB captures.
# A set actually worth publishing goes in deliberately: git add -f Art/Workshop/<file>.
Art/Workshop/*.png

# Full Pickle reports are kept locally before the shared runner releases its lock. Each pass
# includes hundreds of screenshots (about 1 GB); STATUS.md records the verified summary.
Tests/Pickle/evidence/**
# ...except what a citation needs and a clone can check: the verdict files, a few KB each.
# Screenshots and logs stay local.
!Tests/Pickle/evidence/**/
!Tests/Pickle/evidence/**/summary.json
!Tests/Pickle/evidence/**/summary.md
!Tests/Pickle/evidence/**/junit.xml

# Textures the build generates next to the PNGs.
Mod/Textures/**/*.dds

# System
Thumbs.db
desktop.ini
.DS_Store

node_modules/
.npm/
