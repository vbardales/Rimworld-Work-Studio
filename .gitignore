# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up in here,
# since the whole folder goes to the Workshop as is.
.build/
Source/obj/
Source/bin/


# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Art/Gallery/ holds ONLY the images to upload to the Steam page (0- is the Preview), numbered in upload order: tracked.
# The raw captures a Pickle run produces (3-4 MB each, different every run) stay in the run's evidence folder, ignored
# below; copy the chosen ones into Art/Gallery/ by hand.

# Full Pickle reports are kept locally before the shared runner releases its lock. Each pass
# includes hundreds of screenshots (about 1 GB); STATUS.md records the verified summary.
Tests/Pickle/evidence/
evidence/
# A text summary of each run that a document cites is committed under docs/runs/ instead.


# Shared renderer outputs (scripts/Render-Preview.cjs), regenerated on every run; the delivered image is Mod/About/Preview.png.
Art/.render/

# Textures the build generates next to the PNGs.
Mod/Textures/**/*.dds

# System
Thumbs.db
desktop.ini
.DS_Store

node_modules/
.npm/
