# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up in here,
# since the whole folder goes to the Workshop as is.
.build/
Source/obj/
Source/bin/


# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Art/Workshop/ holds ONLY the images to upload to the Steam page, numbered in upload order: tracked.
# The raw captures a Pickle @review run produces (3-4 MB each, different every run) go to
# Art/Workshop/studio-raw/ and are never committed; crop or convert them into Art/Workshop/ by hand.

# Full Pickle reports are kept locally before the shared runner releases its lock. Each pass
# includes hundreds of screenshots (about 1 GB); STATUS.md records the verified summary.
Tests/Pickle/evidence/
# A text summary of each run that a document cites is committed under docs/runs/ instead.

# Raw Workshop captures, 3-4 MB each: only the finished files of Art/Workshop/ are kept.
Art/Workshop/studio-raw/

# Textures the build generates next to the PNGs.
Mod/Textures/**/*.dds

# System
Thumbs.db
desktop.ini
.DS_Store

node_modules/
.npm/
