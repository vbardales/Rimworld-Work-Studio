<Project>

  <PropertyGroup>
    <!--
      Les intermediaires de compilation sortent du dossier publie. L'uploader Workshop envoie
      Mod/ tel quel (SteamUGC.SetItemContent, aucune exclusion possible) : un obj/ qui s'y
      trouverait embarquerait l'Assembly-CSharp.dll publicisee, ~6 Mo, chez chaque abonne.
      Doit rester dans un Directory.Build.props : la restauration NuGet lit cette propriete
      avant le csproj.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
