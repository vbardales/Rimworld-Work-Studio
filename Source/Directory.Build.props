<Project>

  <PropertyGroup>
    <!--
      Build intermediates go outside the published folder. The Workshop uploader sends Mod/ as
      is (SteamUGC.SetItemContent, no exclusion possible): an obj/ sitting in there would ship
      the publicized Assembly-CSharp.dll, ~6 MB, to every subscriber.
      Must stay in a Directory.Build.props: NuGet restore reads this property before the
      csproj.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
